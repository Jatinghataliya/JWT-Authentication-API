# Copy this file to .env and fill in real values before running docker-compose
# .env is git-ignored — never commit actual secrets

# PostgreSQL
POSTGRES_DB=jwtauthdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production

# JWT — generate a strong 256-bit Base64-encoded key for production:
#   openssl rand -base64 32
JWT_SECRET=replace_with_your_256bit_base64_encoded_secret
JWT_EXPIRATION_MS=86400000
